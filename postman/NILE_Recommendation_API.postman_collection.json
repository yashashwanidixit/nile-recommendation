    {
      "name": "Hotel Recommendations",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "});",
              "",
              "pm.test(\"Response contains expected fields\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"status\");",
              "    pm.expect(jsonData).to.have.property(\"recommendation_type\");",
              "    pm.expect(jsonData).to.have.property(\"destination\");",
              "    pm.expect(jsonData).to.have.property(\"group_size\");",
              "    pm.expect(jsonData).to.have.property(\"budget\");",
              "});",
              "",
              "pm.test(\"Recommendation type is hotels\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.recommendation_type).to.eql(\"hotels\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"destination\": \"Goa\",\n  \"start_date\": \"2026-10-10\",\n  \"end_date\": \"2026-10-14\",\n  \"group_size\": 4,\n  \"budget\": 40000,\n  \"preferences\": {\n    \"required\": [\n      \"wifi\"\n    ],\n    \"preferred\": [\n      \"beach\",\n      \"luxury\",\n      \"nightlife\"\n    ]\n  },\n  \"activities\": [\n    \"water_sports\",\n    \"nightlife\"\n  ]\n}"
